        "type": {
          "enum": [
            "primary_statement",
            "public_description",
            "sports_data",
            "market_data",
            "historical_record",
            "evaluation_report",
            "internal_registry",
            "other"
          ]
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "locator": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "retrieved_at_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "excerpt": {
          "$ref": "#/$defs/nullableString"
        },
        "timestamp_reference": {
          "$ref": "#/$defs/nullableString"
        }
