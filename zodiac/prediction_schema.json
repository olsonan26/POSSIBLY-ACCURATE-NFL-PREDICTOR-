        "settlement_rules": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "expected_net_return_per_unit": {
          "type": [
            "number",
            "null"
          ]
        },
        "expected_value_method": {
          "$ref": "#/$defs/nullableString"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds",
          "minItems": 1
        },
        "action": {
          "const": "analysis_only"
        }
      }
