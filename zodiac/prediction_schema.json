          ]
        },
        "identity_check_status": {
          "enum": [
            "passed",
            "failed",
            "not_checked"
          ]
        },
        "calendar_check_status": {
          "enum": [
            "passed",
            "failed",
            "not_checked",
            "not_applicable"
          ]
        }
      }
