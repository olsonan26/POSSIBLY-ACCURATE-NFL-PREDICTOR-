    "research:qb": "bun scripts/qb-value.ts",
    "research:priors": "bun scripts/prior-season-shrinkage.ts",
    "research:wepa": "bun scripts/luck-adjusted-epa.ts",
    "research:snap-continuity": "bun scripts/snap-continuity.ts",
