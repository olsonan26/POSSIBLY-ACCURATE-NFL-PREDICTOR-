# Existing paid pregame research (server only)
OPENROUTER_API_KEY=
OPENROUTER_PREGAME_MODEL=deepseek/deepseek-v4.1-flash

# Outcome-feedback storage. Apply database/learning-schema.sql first.
# Use a Supabase service-role/secret key; NEVER a browser/VITE_ variable.
NFL_LEARNING_SUPABASE_URL=
NFL_LEARNING_SUPABASE_KEY=
# Optional scoped publishable-key adapter: private server secret, never VITE_.
NFL_LEARNING_SECRET=

# Existing independent prediction ledger, if configured
NFL_LEDGER_SUPABASE_URL=
NFL_LEDGER_SUPABASE_KEY=
NFL_LEDGER_SECRET=

# Production daily outcome sync, configured as a protected Vercel cron.
CRON_SECRET=
